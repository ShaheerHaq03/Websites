---
import Logo from '../ui/Logo.astro';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <Logo />
      <p>
        A little less friction.
        <br />A lot more possibilities.
      </p>
      <span class="local-label">
        <span></span> Your images stay on your device.
      </span>
    </div>
    <div>
      <h2>Make it fit</h2>
      <a href="/tools/image-resizer">Image Resizer</a>
      <a href="/tools/image-compressor">Image Compressor</a>
      <a href="/tools/image-cropper">Image Cropper</a>
      <a href="/tools/social-media-image-resizer">Social Image Resizer</a>
    </div>
    <div>
      <h2>Change the format</h2>
      <a href="/tools/png-to-jpg">PNG to JPG</a>
      <a href="/tools/jpg-to-png">JPG to PNG</a>
      <a href="/tools/image-to-webp">Image to WebP</a>
      <a href="/tools/webp-to-png">WebP to PNG</a>
    </div>
    <div>
      <h2>A few useful details</h2>
      <a href="/about">About PixelTools</a>
      <a href="/guides">Image guides</a>
      <a href="/contact">Contact</a>
      <a href="/privacy-policy">Privacy Policy</a>
      <a href="/terms">Terms</a>
