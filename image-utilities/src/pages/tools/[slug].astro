---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolApp from '../../components/tools/ToolApp';
import ToolCard from '../../components/ui/ToolCard.astro';
import Icon from '../../components/ui/Icon.astro';
import AdSlot from '../../components/ui/AdSlot.astro';
import FaqList from '../../components/ui/FaqList.astro';
import { tools, getTool } from '../../data/tools';
import { content, toolHeadings, privacyNote } from '../../content/tools';
import { canonical, site, displayDate } from '../../config/site';
import { workspaceFacts } from '../../lib/seo/markdown';
import { breadcrumbList, faqPage, ids, ref } from '../../lib/seo/schema';
export function getStaticPaths() {
  return tools.map((tool) => ({ params: { slug: tool.id }, props: { tool } }));
}
const { tool } = Astro.props;
const guide = content[tool.id];
const headings = toolHeadings(guide);
const path = `/tools/${tool.id}`;
const schema = [
  {
    '@type': 'WebApplication',
    '@id': `${canonical(path)}#app`,
    name: tool.name,
    url: canonical(path),
    description: guide.answer,
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'Any modern web browser',
    browserRequirements: 'Requires JavaScript.',
    isAccessibleForFree: true,
    inLanguage: 'en',
    dateModified: site.updated,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: ref(ids.organization()),
    mainEntityOfPage: ref(ids.webpage(path)),
  },
  breadcrumbList(path, [
    { name: 'Home', path: '/' },
    { name: 'Image tools', path: '/tools' },
    { name: tool.name, path },
  ]),
  faqPage(path, guide.faq),
];
---

<BaseLayout
  title={guide.metaTitle}
  description={guide.metaDescription}
  pageName={tool.name}
  schema={schema}
  markdownPath={`${path}.md`}
>
  <div class="container tool-page">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/tools">Image tools</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{tool.name}</span>
    </nav>
    <div class="tool-page-heading">
      <span class={`tool-icon ${tool.color}`}>
        <Icon name={tool.icon} size={29} />
      </span>
      <div>
        <span class="eyebrow">{tool.category}</span>
        <h1>{tool.name}</h1>
        <p>{tool.description}</p>
      </div>
      <span class="privacy-pill">
        <span></span> LOCAL & PRIVATE
      </span>
    </div>
    <ToolApp id={tool.id} client:only="react">
      <div slot="fallback" class="tool-loading" role="status">
        Preparing your local image workspace…
      </div>
    </ToolApp>
    <noscript>
      <p class="notice">
        Enable JavaScript for local image processing. The usage guide below is
        available without it.
      </p>
    </noscript>
    <div class="workspace-disclaimer">{workspaceFacts}</div>
    <section class="tool-guide" id="guide">
      <div class="guide-main">
        <span class="eyebrow">A LITTLE CONTEXT HELPS.</span>
        <h2>{headings.what}</h2>
        <p class="direct-answer">{guide.answer}</p>
        <p>{guide.intro}</p>
        <p class="updated-note">
          Last updated{' '}
          <time datetime={site.updated}>{displayDate(site.updated)}</time>
        </p>
        <h3>{headings.how}</h3>
        <ol>
          {guide.steps.map((step) => (
            <li>{step}</li>
          ))}
        </ol>
        <div class="worked-example">
          <span>AN EVERYDAY EXAMPLE</span>
          <p>{guide.example}</p>
        </div>
        <h3>{headings.uses}</h3>
        <ul>
          {guide.uses.map((use) => (
            <li>{use}</li>
          ))}
        </ul>
        <h3>{headings.quality}</h3>
        <p>{guide.quality}</p>
        <h3>{headings.limits}</h3>
        <p>{guide.limits}</p>
        <h3>{headings.privacy}</h3>
        <p>
          {privacyNote} Read our <a href="/privacy-policy">privacy policy</a>{' '}
          for the full picture.
        </p>
      </div>
      <aside class="guide-sidebar">
        <h2>In this workspace</h2>
        <a href="#main">↑ Back to your image</a>
        <a href="#faq">Common questions</a>
        <a href="#related">Related tools</a>
        <div>
          <Icon name="shield" size={27} />
          <strong>Kept close to home.</strong>
          <p>
            Your image doesn’t need to go anywhere to become something better.
          </p>
        </div>
      </aside>
    </section>
    <section class="faq-section" id="faq">
      <div>
        <span class="eyebrow">GOOD QUESTIONS.</span>
        <h2>{headings.faq}</h2>
      </div>
      <FaqList items={guide.faq} />
    </section>
    <AdSlot />
    <section id="related" class="related-section">
      <div class="section-heading">
        <div>
          <h2>Keep the good work going.</h2>
          <p>A few more tools for your next step.</p>
        </div>
        <a class="text-link" href="/tools">
          All image tools ↗
        </a>
      </div>
      <div class="tools-grid related-grid">
        {tool.related.map((id) => (
          <ToolCard tool={getTool(id)} />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
