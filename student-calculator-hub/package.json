{
  "name": "student-calculator-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "pnpm check && pnpm lint && pnpm test && pnpm build && pnpm test:e2e",
    "launch:check": "node scripts/check-launch.mjs",
    "audit:lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "astro": "7.4.2",
    "@astrojs/react": "7.1.1",
    "@astrojs/sitemap": "latest",
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "oxc-transform-react": "^0.145.0",
    "@fontsource-variable/inter": "latest"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "typescript": "6.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "vitest": "5.0.5",
    "@playwright/test": "1.64.1",
    "@axe-core/playwright": "latest",
    "eslint": "10.13.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.72.0",
    "eslint-plugin-astro": "latest",
    "eslint-plugin-react-hooks": "latest",
    "prettier": "latest",
    "prettier-plugin-astro": "latest",
    "globals": "latest",
    "lighthouse": "latest"
  },
  "pnpm": {
    "overrides": {
      "@astrojs/react>@vitejs/plugin-react": "6.0.2",
      "@opentelemetry/api": "1.9.1"
    }
  }
}
