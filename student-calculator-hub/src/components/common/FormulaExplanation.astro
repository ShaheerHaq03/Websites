---
interface Props {
  formula: string;
  explanation: string;
  /** Section heading, ideally phrased as the question a student would search. */
  heading?: string;
}
const { formula, explanation, heading = 'The math, made clear' } = Astro.props;
---

<section id="formula">
  <h2>{heading}</h2>
  <div class="formula-explanation">
    <span>THE FORMULA</span>
    <p>{formula}</p>
  </div>
  <p>{explanation}</p>
</section>
