---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/common/Icon.astro';
import ToolCard from '../components/common/ToolCard.astro';
import ToolDirectory from '../components/common/ToolDirectory.astro';
import CategoryCards from '../components/common/CategoryCards.astro';
import { tool } from '../data/calculators';
---

<BaseLayout
  title="Free GPA, Grade & Attendance Calculators"
  description="Make every grade count with 12 free student calculators. Work out GPA, final exam scores, attendance, and study plans with clear formulas and examples."
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <div class="hero-pill">
          <span class="status-dot" /> BIG PLANS. CLEARER NUMBERS.
        </div>
        <h1>
          Make Every
          <br />
          Grade{' '}
          <span class="hero-word">
            Count.
            <svg viewBox="0 0 260 16" aria-hidden="true">
              <path d="M3 11Q120 1 253 8" />
            </svg>
          </span>
        </h1>
        <p class="hero-description">
          Less guesswork. More possibility.
          <br />
          Free, accurate calculators for your grades, GPA, attendance, and everything you’re working
          toward.
        </p>
        <div class="hero-buttons">
          <a class="button button-primary" href="#all-calculators">
            Explore calculators <Icon name="arrow" size={18} />
          </a>
          <a class="button button-outline" href="/calculators/gpa-calculator">
            Calculate my GPA
          </a>
        </div>
        <div class="hero-assurances">
          <span>
            <Icon name="check" size={15} /> Always free
          </span>
          <span>
            <Icon name="shield" size={15} /> No sign-up
          </span>
          <span>
            <Icon name="clock" size={15} /> Answers in seconds
          </span>
        </div>
      </div>
      <div
        class="hero-art"
        aria-label="Worked example: a projected semester GPA of 3.67 on a 4.0 scale"
      >
        <div class="orbit orbit-one"></div>
        <div class="orbit orbit-two"></div>
        <span class="art-star star-one" aria-hidden="true">
          ✦
        </span>
        <span class="art-star star-two" aria-hidden="true">
          ✧
        </span>
        <div class="semester-demo">
          <div class="demo-heading">
            <span class="demo-icon">
              <Icon name="graduation" size={22} />
            </span>
            <div>
              <strong>Your semester, in focus</strong>
              <small>A little planning goes a long way.</small>
            </div>
            <span class="demo-dots" aria-hidden="true">
              •••
            </span>
          </div>
          <div class="demo-gpa">
            <span>PROJECTED GPA</span>
            <div>
              <strong>3.67</strong>
              <span>/ 4.00</span>
              <span class="demo-trend">
                <Icon name="trend" size={16} /> Looking ahead
              </span>
            </div>
            <div class="demo-bar">
              <span></span>
            </div>
          </div>
          <div class="demo-table">
            <div>
              <span>COURSE</span>
              <span>CREDITS</span>
              <span>GRADE</span>
            </div>
            <div>
              <span>
                <i class="course-dot dot-blue"></i> Mathematics
              </span>
              <span>3</span>
              <b>A</b>
            </div>
            <div>
              <span>
                <i class="course-dot dot-violet"></i> English
              </span>
              <span>3</span>
              <b>A</b>
            </div>
            <div>
              <span>
                <i class="course-dot dot-orange"></i> Biology
              </span>
              <span>3</span>
              <b>B</b>
            </div>
          </div>
          <div class="demo-footer">
            <span>3 courses · 9 credits</span>
            <span>
              Worked example <span aria-hidden="true">↗</span>
            </span>
          </div>
        </div>
        <div class="floating-note note-target">
          <span class="small-icon color-orange">
            <Icon name="target" size={20} />
          </span>
          <div>
            <strong>Your next goal?</strong>
            <small>Let’s work it out.</small>
          </div>
        </div>
        <div class="floating-note note-free">
          <span class="small-icon color-emerald">
            <Icon name="check" size={18} />
          </span>
          <div>
            <strong>Clear answers.</strong>
            <small>Zero spreadsheets.</small>
          </div>
        </div>
      </div>
    </div>
  </section>
  <div class="trust-strip">
    <div class="container">
      <span>BUILT AROUND YOUR STUDENT LIFE</span>
      <span>
        <Icon name="graduation" size={20} /> Grades & GPA
      </span>
      <span>
        <Icon name="calendar" size={19} /> Attendance
      </span>
      <span>
        <Icon name="book" size={19} /> Exams & assignments
      </span>
      <span>
        <Icon name="clock" size={19} /> Study planning
      </span>
    </div>
  </div>
  <section class="section container" aria-labelledby="featured-heading">
    <div class="section-heading">
      <div>
        <span class="eyebrow">A GOOD PLACE TO START</span>
        <h2 id="featured-heading">Small tools. Big clarity.</h2>
        <p>The everyday favorites for your next academic decision.</p>
      </div>
      <a class="text-link" href="/calculators">
        View all calculators <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="featured-grid">
      {(['gpa', 'final', 'weighted', 'attendance'] as const).map((id) => (
        <ToolCard calculator={tool(id)} featured />
      ))}
    </div>
  </section>
  <section class="directory-section" id="all-calculators">
    <div class="container section">
      <div class="section-heading">
        <div>
          <span class="eyebrow">YOUR ACADEMIC TOOLKIT</span>
          <h2>A calculator for every “what if”.</h2>
          <p>Find your answer. Make your next move.</p>
        </div>
        <span class="tools-total">
          12 free tools <span aria-hidden="true">✦</span>
        </span>
      </div>
      <CategoryCards />
      <ToolDirectory />
    </div>
  </section>
  <section class="section container how-section" id="how-it-works">
    <div class="section-heading centered">
      <span class="eyebrow">NO LEARNING CURVE REQUIRED</span>
      <h2>From “what if” to “got it”.</h2>
      <p>Three simple steps. One less thing on your mind.</p>
    </div>
    <div class="steps-grid">
      {[
        {
          n: '01',
          icon: 'search',
          title: 'Find your tool',
          text: 'Choose the calculator that fits your question, from semester GPA to your next exam.',
        },
        {
          n: '02',
          icon: 'document',
          title: 'Make it yours',
          text: 'Enter your numbers and match the settings to your course or institution.',
        },
        {
          n: '03',
          icon: 'spark',
          title: 'See the bigger picture',
          text: 'Get a clear result, understand the formula, and plan what comes next.',
        },
      ].map((s) => (
        <article>
          <div class="step-top">
            <span class="step-icon">
              <Icon name={s.icon} size={27} />
            </span>
            <span>{s.n}</span>
          </div>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </article>
      ))}
    </div>
  </section>
  <section class="container">
    <div class="learning-banner">
      <div>
        <span class="eyebrow">MORE THAN A NUMBER</span>
        <h2>
          Understand the math.
          <br />
          Own your next step.
        </h2>
        <p>
          Every tool comes with a clear formula, a worked example, and the context that helps you
          use the answer well. Because knowing “why” matters just as much as knowing “what”.
        </p>
        <a class="text-link" href="/about">
          Get to know Student Hub <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="learning-art" aria-hidden="true">
        <div class="formula-paper">
          <span>THE FORMULA, MADE SIMPLE</span>
          <strong>
            your effort
            <br />
            <i>+ a little clarity</i>
          </strong>
          <hr />
          <b>your next possibility.</b>
          <span class="paper-spark">✦</span>
        </div>
      </div>
    </div>
  </section>
  <section class="section container faq-section">
    <div>
      <span class="eyebrow">A FEW THINGS TO KNOW</span>
      <h2>
        Good questions.
        <br />
        Clear answers.
      </h2>
      <p>
        Still curious? Read more <a href="/about">about our approach</a>.
      </p>
    </div>
    <div class="faq-list">
      <details>
        <summary>Are these calculators really free?</summary>
        <p>Yes. All 12 calculators are free to use without an account, subscription, or paywall.</p>
      </details>
      <details>
        <summary>Will the results match my university’s rules?</summary>
        <p>
          The arithmetic follows the formulas shown, but grading policies vary. Match the editable
          scales and weights to your syllabus, and use your official records for final decisions.
        </p>
      </details>
      <details>
        <summary>Are my grades saved or shared?</summary>
        <p>
          Calculations run in your browser. We do not upload your inputs or save grades on a server.
          Only your theme preference is saved locally.
        </p>
      </details>
      <details>
        <summary>Can I use these tools on my phone?</summary>
        <p>
          Yes. Every calculator is designed for small screens, with labeled inputs, clear results,
          and no app to install.
        </p>
      </details>
    </div>
  </section>
  <section class="container final-cta">
    <span class="eyebrow">YOUR NEXT CHAPTER STARTS WITH CLARITY</span>
    <h2>
      You’ve got goals.
      <br />
      We’ve got the numbers.
    </h2>
    <a class="button button-primary" href="/calculators">
      Find your calculator <Icon name="arrow" size={18} />
    </a>
    <p>Free to use. Built for students. Always within reach.</p>
  </section>
</BaseLayout>
