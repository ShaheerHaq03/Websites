---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { calculators, type CalculatorInfo } from '../../data/calculators';
import Calculator from '../../components/calculators/Calculator';
import FormulaExplanation from '../../components/common/FormulaExplanation.astro';
import ExamplePanel from '../../components/common/ExamplePanel.astro';
import RelatedTools from '../../components/common/RelatedTools.astro';
import Icon from '../../components/common/Icon.astro';
import AdSlot from '../../components/common/AdSlot.astro';
import { site } from '../../config/site';
export function getStaticPaths() {
  return calculators.map((calculator) => ({
    params: { slug: calculator.slug },
    props: { calculator },
  }));
}
interface Props {
  calculator: CalculatorInfo;
}
const { calculator: c } = Astro.props;
const canonical = `${site.url}/calculators/${c.slug}`;
const markdownPath = `/calculators/${c.slug}.md`;
const updatedLabel = new Date(`${site.updated}T00:00:00Z`).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Calculators', path: '/calculators' },
  { name: c.title, path: `/calculators/${c.slug}` },
];
const schema = [
  {
    '@type': 'WebApplication',
    '@id': `${canonical}#app`,
    name: c.title,
    url: canonical,
    description: c.description,
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Any',
    isAccessibleForFree: true,
    browserRequirements: 'Requires JavaScript for calculations',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: { '@id': `${site.url}/#organization` },
    mainEntityOfPage: { '@id': `${canonical}#webpage` },
  },
  // Mirrors the visible "questions, answered" section word for word.
  {
    '@type': 'FAQPage',
    '@id': `${canonical}#faq`,
    isPartOf: { '@id': `${canonical}#webpage` },
    mainEntity: c.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title={c.seoTitle}
  description={c.description}
  schema={schema}
  breadcrumbs={breadcrumbs}
  mainEntity={`${canonical}#app`}
  markdownPath={markdownPath}
>
  <div class="container calculator-page">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/calculators">Calculators</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{c.title}</span>
    </nav>
    <header class="calculator-page-header">
      <span class:list={['tool-icon', `color-${c.color}`]}>
        <Icon name={c.icon} size={28} />
      </span>
      <div>
        <span class="eyebrow">{c.category} · FREE STUDENT TOOL</span>
        <h1>{c.title}</h1>
        <p>{c.description}</p>
        <p class="page-updated">
          Last updated <time datetime={site.updated}>{updatedLabel}</time>
        </p>
      </div>
    </header>
    <Calculator id={c.id} slug={c.slug} client:load />
    <noscript>
      <div class="input-note">
        Please enable JavaScript to use the interactive calculator. The formula, instructions, and
        worked example below remain available without it.
      </div>
    </noscript>
    <div class="content-layout">
      <aside class="content-nav" aria-label="On this page">
        <strong>IN THIS GUIDE</strong>
        <a href="#overview">What it is</a>
        <a href="#how-to">How to use it</a>
        <a href="#formula">The formula</a>
        <a href="#example">Worked example</a>
        <a href="#mistakes">Common mistakes</a>
        <a href="#limitations">Before you decide</a>
        <a href="#questions">Your questions</a>
      </aside>
      <article class="calculator-content">
        <section id="overview">
          <span class="eyebrow">A LITTLE CONTEXT</span>
          <h2>What is the {c.title}?</h2>
          <p>{c.answer}</p>
          <p>{c.intro}</p>
        </section>
        <section id="how-to">
          <h2>How do I use the {c.title}?</h2>
          <ol>
            {c.steps.map((step) => (
              <li>{step}</li>
            ))}
          </ol>
        </section>
        <FormulaExplanation
          formula={c.formula}
          explanation={c.explanation}
          heading={c.formulaQuestion}
        />
        <ExamplePanel example={c.example} />
        <section id="mistakes">
          <h2>What mistakes should I avoid?</h2>
          <ul>
            {c.mistakes.map((m) => (
              <li>{m}</li>
            ))}
          </ul>
        </section>
        <section id="limitations">
          <h2>How reliable is this result?</h2>
          <p>{c.limitation}</p>
          <p>
            Use this estimate alongside your syllabus and official records. See our{' '}
            <a href="/disclaimer">educational disclaimer</a> for more context.
          </p>
        </section>
        <section id="questions">
          <h2>{c.title}: your questions, answered</h2>
          <div class="faq-list">
            {c.faqs.map((f) => (
              <details>
                <summary>
                  <h3>{f.q}</h3>
                </summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </section>
      </article>
    </div>
    <AdSlot />
    <RelatedTools related={c.related} />
  </div>
  <script>
    import { track } from '../../lib/analytics';
    document
      .querySelectorAll<HTMLAnchorElement>('[data-related] a')
      .forEach((a) =>
        a.addEventListener('click', () =>
          track('related_tool_opened', a.pathname.split('/').pop() || ''),
        ),
      );
  </script>
</BaseLayout>
