---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { calculators, type CalculatorInfo } from '../../data/calculators';
import Calculator from '../../components/calculators/Calculator';
import FormulaExplanation from '../../components/common/FormulaExplanation.astro';
import ExamplePanel from '../../components/common/ExamplePanel.astro';
import RelatedTools from '../../components/common/RelatedTools.astro';
import Icon from '../../components/common/Icon.astro';
import AdSlot from '../../components/common/AdSlot.astro';
import { site } from '../../config/site';
export function getStaticPaths() {
  return calculators.map((calculator) => ({
    params: { slug: calculator.slug },
    props: { calculator },
  }));
}
interface Props {
  calculator: CalculatorInfo;
}
const { calculator: c } = Astro.props;
const schema = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Calculators', item: `${site.url}/calculators` },
      {
        '@type': 'ListItem',
        position: 3,
        name: c.title,
        item: `${site.url}/calculators/${c.slug}`,
      },
    ],
  },
  {
    '@type': 'WebApplication',
    name: c.title,
    url: `${site.url}/calculators/${c.slug}`,
    description: c.description,
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Any',
    isAccessibleForFree: true,
    browserRequirements: 'Requires JavaScript for calculations',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
];
---

<BaseLayout title={`${c.title} — Free Online Tool`} description={c.description} schema={schema}>
  <div class="container calculator-page">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/calculators">Calculators</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{c.title}</span>
    </nav>
    <header class="calculator-page-header">
      <span class:list={['tool-icon', `color-${c.color}`]}>
        <Icon name={c.icon} size={28} />
      </span>
      <div>
        <span class="eyebrow">{c.category} · FREE STUDENT TOOL</span>
        <h1>{c.title}</h1>
        <p>{c.description}</p>
      </div>
    </header>
    <Calculator id={c.id} slug={c.slug} client:load />
    <noscript>
      <div class="input-note">
        Please enable JavaScript to use the interactive calculator. The formula, instructions, and
        worked example below remain available without it.
      </div>
    </noscript>
    <div class="content-layout">
      <aside class="content-nav" aria-label="On this page">
        <strong>IN THIS GUIDE</strong>
        <a href="#overview">The bigger picture</a>
        <a href="#how-to">How to use it</a>
        <a href="#formula">The formula</a>
        <a href="#example">Worked example</a>
        <a href="#mistakes">Common mistakes</a>
        <a href="#limitations">Before you decide</a>
        <a href="#questions">Your questions</a>
      </aside>
      <article class="calculator-content">
        <section id="overview">
          <span class="eyebrow">A LITTLE CONTEXT</span>
          <h2>The bigger picture</h2>
          <p>{c.intro}</p>
        </section>
        <section id="how-to">
          <h2>How to use the {c.title.toLowerCase()}</h2>
          <ol>
            {c.steps.map((step) => (
              <li>{step}</li>
            ))}
          </ol>
        </section>
        <FormulaExplanation formula={c.formula} explanation={c.explanation} />
        <ExamplePanel example={c.example} />
        <section id="mistakes">
          <h2>Common mistakes to avoid</h2>
          <ul>
            {c.mistakes.map((m) => (
              <li>{m}</li>
            ))}
          </ul>
        </section>
        <section id="limitations">
          <h2>Before you decide</h2>
          <p>{c.limitation}</p>
          <p>
            Use this estimate alongside your syllabus and official records. See our{' '}
            <a href="/disclaimer">educational disclaimer</a> for more context.
          </p>
        </section>
        <section id="questions">
          <h2>Your questions, answered</h2>
          <div class="faq-list">
            {c.faqs.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </section>
      </article>
    </div>
    <AdSlot />
    <RelatedTools related={c.related} />
  </div>
  <script>
    import { track } from '../../lib/analytics';
    document
      .querySelectorAll<HTMLAnchorElement>('[data-related] a')
      .forEach((a) =>
        a.addEventListener('click', () =>
          track('related_tool_opened', a.pathname.split('/').pop() || ''),
        ),
      );
  </script>
</BaseLayout>
