---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolDirectory from '../components/ui/ToolDirectory.astro';
import { pages } from '../data/pages';
import { tools } from '../data/tools';
import { itemList, ref } from '../lib/seo/schema';
const list = itemList(
  '/',
  'Developer tools',
  tools.map((tool) => ({
    name: tool.name,
    path: `/tools/${tool.id}`,
    description: tool.description,
  })),
);
---

<BaseLayout
  title={pages.home.seoTitle}
  description={pages.home.metaDescription}
  pageType={pages.home.pageType}
  webPageExtra={{ mainEntity: ref(list['@id'] as string) }}
  schema={[list]}
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <div class="eyebrow">
          <span class="green-dot"></span> YOUR EVERYDAY DEVELOPMENT TOOLKIT
        </div>
        <h1>
          Everyday developer
          <br /> tools, <span>done right.</span>
        </h1>
        <p class="hero-description">
          Less busywork. More building. Format JSON, compare data, convert
          files, and debug the little things—all in your browser.
        </p>
        <div class="hero-actions">
          <a href="#all-tools" class="btn btn-primary btn-large">
            Explore all tools <span aria-hidden="true">→</span>
          </a>
          <a href="/tools/json-formatter" class="btn btn-large">
            Open JSON Formatter <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="hero-trust">
          <span>
            <svg
              width="15"
              height="15"
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              aria-hidden="true"
            >
              <path d="m4 10 4 4 8-8" />
            </svg>{' '}
            Always free
          </span>
          <span>
            <svg
              width="15"
              height="15"
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              aria-hidden="true"
            >
              <path d="m4 10 4 4 8-8" />
            </svg>{' '}
            No signup
          </span>
          <span>
            <svg
              width="15"
              height="15"
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              aria-hidden="true"
            >
              <path d="m4 10 4 4 8-8" />
            </svg>{' '}
            No uploads
          </span>
        </div>
      </div>
      <div class="hero-visual">
        <div class="code-window">
          <div class="window-top">
            <div class="window-dots">
              <span></span>
              <span></span>
              <span></span>
            </div>
            <span>developer-happiness.json</span>
            <span class="window-json">JSON</span>
          </div>
          <div class="preview-tabs">
            <button type="button" data-preview="input">
              Input
            </button>
            <button
              type="button"
              data-preview="output"
              class="active"
              aria-pressed="true"
            >
              Formatted output
            </button>
            <span>
              <span class="green-dot"></span> Valid JSON
            </span>
          </div>
          <div class="preview-code" id="preview-formatted">
            <div class="line-numbers" aria-hidden="true">
              1<br />2<br />3<br />4<br />5<br />6<br />7<br />8<br />9<br />
              10
            </div>
            <pre><span class="punct">&#123;</span>
  <span class="prop">"name"</span>: <span class="str">"Ada Lovelace"</span>,
  <span class="prop">"role"</span>: <span class="str">"Developer"</span>,
  <span class="prop">"active"</span>: <span class="bool">true</span>,
  <span class="prop">"skills"</span>: [
    <span class="str">"JavaScript"</span>,
    <span class="str">"TypeScript"</span>
  ],
  <span class="prop">"projects"</span>: <span class="num">12</span>
<span class="punct">&#125;</span></pre>
          </div>
          <div class="preview-code" id="preview-input" hidden>
            <pre>{'{"name":"Ada Lovelace","role":"Developer","active":true,"skills":["JavaScript","TypeScript"],"projects":12}'}</pre>
          </div>
          <div class="window-bottom">
            <span>
              <span aria-hidden="true">✓</span> Ready for your next big idea.
            </span>
            <a href="/tools/json-formatter">Try it yourself →</a>
          </div>
        </div>
        <div class="floating-privacy">
          <span class="privacy-icon" aria-hidden="true">
            <svg
              width="23"
              height="23"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
            >
              <path d="m12 3 8 3v6c0 4-5 7-8 9-3-2-8-5-8-9V6l8-3Z" />
              <path d="m8 12 3 3 5-6" />
            </svg>
          </span>
          <div>
            <strong>Your data stays yours.</strong>
            <span>Local processing. Zero server uploads.</span>
          </div>
          <span class="green-dot"></span>
        </div>
      </div>
    </div>
    <div class="container hero-bottom">
      <span>THE RIGHT TOOL, RIGHT WHEN YOU NEED IT.</span>
      <div>
        <strong>12</strong> purpose-built tools
      </div>
      <div>
        <strong>0</strong> accounts required
      </div>
      <div>
        <svg
          width="19"
          height="19"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          aria-hidden="true"
        >
          <path d="m13 2-9 12h7l-1 8 10-12h-7l1-8Z" />
        </svg>{' '}
        Browser-powered
      </div>
    </div>
  </section>
  <section class="section toolkit-section container" id="all-tools">
    <div class="section-heading">
      <div>
        <div class="eyebrow">SMALL UTILITIES. BIG TIME SAVERS.</div>
        <h2>Your everyday toolkit</h2>
        <p>Pick a tool. Paste your data. Get back to building.</p>
      </div>
      <span class="count-label">12 tools, always free</span>
    </div>
    <ToolDirectory />
  </section>
  <section class="privacy-section">
    <div class="container privacy-grid">
      <div class="privacy-art" aria-hidden="true">
        <div class="privacy-art-ring">
          <svg
            width="74"
            height="74"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1"
          >
            <path d="m12 3 8 3v6c0 4-5 7-8 9-3-2-8-5-8-9V6l8-3Z" />
            <path d="m8 12 3 3 5-6" />
          </svg>
        </div>
        <span class="privacy-art-label">LOCAL-FIRST BY DESIGN</span>
      </div>
      <div>
        <div class="eyebrow">YOUR DATA IS YOUR BUSINESS.</div>
        <h2>
          Useful tools.
          <br />
          Without the upload.
        </h2>
        <p>
          API responses, configuration files, and test tokens can hold sensitive
          information. Core tool operations run right here in your browser, so
          your input doesn’t need to leave your tab.
        </p>
        <div class="privacy-points">
          <span>✓ No account to create</span>
          <span>✓ No input in analytics</span>
          <span>✓ No conversion APIs</span>
          <span>✓ No saved payload history</span>
        </div>
        <a class="text-link" href="/privacy-policy">
          Read how privacy works <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
  <section class="section container workflow-section">
    <div class="section-heading">
      <div>
        <div class="eyebrow">FROM “WHY?” TO “GOT IT.”</div>
        <h2>Built for the work between the work</h2>
        <p>Quick answers for the small things that slow you down.</p>
      </div>
    </div>
    <div class="workflow-grid">
      <article>
        <span class="workflow-number">01 / DEBUG</span>
        <h3>Make sense of an API response</h3>
        <p>
          Pretty-print the payload, validate the structure, and compare it with
          yesterday’s response.
        </p>
        <a href="/tools/json-formatter">Start with JSON Formatter →</a>
      </article>
      <article>
        <span class="workflow-number">02 / TRANSFORM</span>
        <h3>Get your data into the right shape</h3>
        <p>
          Turn nested JSON into a spreadsheet, or convert a quoted CSV export
          into predictable JSON.
        </p>
        <a href="/tools/json-to-csv">Convert JSON to CSV →</a>
      </article>
      <article>
        <span class="workflow-number">03 / INSPECT</span>
        <h3>Untangle the details</h3>
        <p>
          Read token claims, check a timestamp, or find out exactly what that
          HTTP status means.
        </p>
        <a href="/tools/jwt-decoder">Inspect a demo JWT →</a>
      </article>
    </div>
  </section>
  <section class="container learn-section">
    <div>
      <span class="eyebrow">A LITTLE CONTEXT GOES A LONG WAY.</span>
      <h2>Good tools explain the details.</h2>
      <p>
        Every utility includes practical examples, clear limitations, and
        troubleshooting notes—because correct output starts with understanding
        your input.
      </p>
    </div>
    <div class="learn-links">
      <a href="/tools/json-diff#guide">
        <span>JSON arrays: order vs. duplicates</span>
        <span aria-hidden="true">↗</span>
      </a>
      <a href="/tools/jwt-decoder#guide">
        <span>Decoded JWT ≠ verified JWT</span>
        <span aria-hidden="true">↗</span>
      </a>
      <a href="/tools/cron-expression-builder#guide">
        <span>What five-field cron actually means</span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</BaseLayout>
<script>
  const buttons =
    document.querySelectorAll<HTMLButtonElement>('[data-preview]');
  for (const button of buttons)
    button.addEventListener('click', () => {
      const formatted = button.dataset.preview === 'output';
      document.querySelector<HTMLElement>('#preview-formatted')!.hidden =
        !formatted;
      document.querySelector<HTMLElement>('#preview-input')!.hidden = formatted;
      for (const tab of buttons) {
        tab.classList.toggle('active', tab === button);
        tab.setAttribute('aria-pressed', String(tab === button));
      }
    });
</script>
