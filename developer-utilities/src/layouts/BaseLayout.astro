---
import interFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { site, canonical } from '../config/site';
import type { PageType } from '../data/pages';
import {
  organization,
  website,
  webPage,
  breadcrumbList,
  serialize,
  type Node,
  type Crumb,
} from '../lib/seo/schema';
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** schema.org type of the page node: WebPage, CollectionPage, AboutPage, ContactPage. */
  pageType?: PageType;
  /** Breadcrumb trail (including the current page) mirrored as a BreadcrumbList. */
  breadcrumbs?: Crumb[];
  /** Extra properties for the WebPage node, e.g. mainEntity. */
  webPageExtra?: Node;
  /** Additional page-specific @graph nodes (WebApplication, ItemList, FAQPage…). */
  schema?: Node[];
  /** Root-relative path of a Markdown twin of this page, if one exists. */
  markdownPath?: string;
}
const {
  title,
  description,
  noindex = false,
  pageType = 'WebPage',
  breadcrumbs,
  webPageExtra,
  schema = [],
  markdownPath,
} = Astro.props;
const path = Astro.url.pathname;
const graph = [
  organization(),
  website(),
  webPage({
    path,
    type: pageType,
    name: title,
    description,
    hasBreadcrumb: Boolean(breadcrumbs?.length),
    extra: webPageExtra,
  }),
  ...(breadcrumbs?.length ? [breadcrumbList(path, breadcrumbs)] : []),
  ...schema,
];
const socialImage = canonical(site.socialImage.path);
---

<!doctype html>
<html lang="en" data-theme="light" data-theme-key={site.theme.storageKey}>
  <head>
    <meta charset="UTF-8" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={interFont}
      crossorigin
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title} | {site.name}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical(Astro.url.pathname)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#2563eb" />
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow'}
    />
    {markdownPath && (
      <link
        rel="alternate"
        type="text/markdown"
        href={new URL(markdownPath, site.url).href}
      />
    )}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical(Astro.url.pathname)} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(site.socialImage.width)} />
    <meta
      property="og:image:height"
      content={String(site.socialImage.height)}
    />
    <meta property="og:image:alt" content={site.socialImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={site.socialImage.alt} />
    <script is:inline>
      try {
        const r = document.documentElement,
          t = localStorage.getItem(r.dataset.themeKey);
        r.dataset.theme =
          t === 'dark' || t === 'light'
            ? t
            : matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
      } catch {
        document.documentElement.dataset.theme = matchMedia(
          '(prefers-color-scheme: dark)',
        ).matches
          ? 'dark'
          : 'light';
      }
    </script>
    <script type="application/ld+json" set:html={serialize(graph)} />
  </head>
  <body id="top">
    <a href="#main" class="skip-link">
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
